severity-ceiling: high
context-window: 0
tags: static
remediation: Remove the literal credential from the assignment and rotate it.
  Supply it at runtime from the environment or a secret store; a value committed in a
  .env file, a Dockerfile ENV, or a CI configuration is committed in git history.
references: CWE-798

id: SAST-SEC-JWT-01
title: Hardcoded JSON Web Token
severity: high
confidence: medium
cwe: CWE-798
owasp: A07:2025
pattern: eyJ[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]{30,}
dialect: ere
match-deny: (SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c|eyJpc3MiOiJzdXBhYmFzZS1kZW1vIi|InJvbGUiOiJhbm9u|Jyb2xlIjoiYW5vbi|cm9sZSI6ImFub24)
severity-ceiling: high
tags: static
remediation: Remove the token from source; a hardcoded JWT is a long-lived bearer credential
  and must be treated as compromised once committed.
  Mint tokens at runtime through the normal authentication flow instead.
references: CWE-798

# A well-known DEFAULT value (a password set to the word password itself, or a
# Postgres password set to postgres) is a guessable weak default (CWE-1392),
# not a leaked secret.  It is still reported - the leaky-repo bench plants
# exactly such a value as a real credential - but at its own, lower severity
# rather than as a CRITICAL hardcoded secret: a severity that varies with context is a second check id.
# It matches the quoted form and the unquoted, line-anchored form; the
# GENERIC_PASSWORD and ENV_ASSIGNMENT records carry the inverse match-deny, so
# one value is reported by exactly one record.
id: SAST-SEC-DEFAULT_PASSWORD-01
title: Well-known default password literal
severity: medium
confidence: medium
cwe: CWE-1392
owasp: A07:2025
pattern: ([A-Za-z0-9_-]*([Pp][Aa][Ss][Ss]([Ww]([Oo][Rr])?[Dd]|[Pp][Hh][Rr][Aa][Ss][Ee])|[Pp][Ww][Dd])[A-Za-z0-9_-]*[\"']?[[:space:]]*[:=][[:space:]]*[\"'`]([Pp]assword|[Pp]assw0rd|[Pp]@ssw0rd|[Ss]ecret|postgres|[Aa]dmin123|[Cc]hangeit|[Ll]etmein|[Ww]elcome1?|qwerty|123456|12345678|[Pp]ass123|[Pp]assword1|[Pp]assword123|[Tt]est123|default)["'`]|^[[:space:]]*(-[[:space:]]+)?([A-Za-z_][A-Za-z0-9_.-]*:[[:space:]]+)?(([Ee][Xx][Pp][Oo][Rr][Tt]|ENV|ARG|[Rr][Ee][Aa][Dd][Oo][Nn][Ll][Yy]|[Dd][Ee][Cc][Ll][Aa][Rr][Ee]|[Ll][Oo][Cc][Aa][Ll])[[:space:]]+)?[A-Za-z0-9_-]*([Pp][Aa][Ss][Ss]([Ww]([Oo][Rr])?[Dd]|[Pp][Hh][Rr][Aa][Ss][Ee])|[Pp][Ww][Dd])[A-Za-z0-9_-]*[\"']?[[:space:]]*[:=][[:space:]]*([Pp]assword|[Pp]assw0rd|[Pp]@ssw0rd|[Ss]ecret|postgres|[Aa]dmin123|[Cc]hangeit|[Ll]etmein|[Ww]elcome1?|qwerty|123456|12345678|[Pp]ass123|[Pp]assword1|[Pp]assword123|[Tt]est123|default)([[:space:]]|$))
