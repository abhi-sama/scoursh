severity-ceiling: high
context-window: 0
tags: static
remediation: Remove the literal password from source and rotate the credential.
  Read it from an environment variable or a secret store at runtime, never as a literal
  assignment in code.
references: CWE-798

# secret / token / credential, any case, any quote style.  Sibling of
# GENERIC_PASSWORD for the identifier family a password rule cannot name -
# CLIENT_SECRET, AUTH_TOKEN, DB_CREDENTIALS.  8 bytes rather than 6: these
# are issued strings, not chosen ones.
id: SAST-SEC-GENERIC_SECRET-01
title: Hardcoded secret, token or credential literal
severity: high
confidence: medium
cwe: CWE-798
owasp: A07:2025
pattern: [A-Za-z0-9_-]*([Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll])[A-Za-z0-9_-]*[\"']?[[:space:]]*[:=][[:space:]]*[\"'`][^\"'`[:space:]]{8,}[\"'`]
dialect: ere
context-deny: \$\{
context-deny: \$\(
context-deny: \{\{
context-deny: %\(
context-deny: <%
context-deny: (os\.environ|getenv|GetEnv|process\.env|System\.getenv|Deno\.env|ENV\[|environ\[|Environment\.Get)
context-deny: (vault|Vault|VAULT|secretsmanager|SecretsManager|secretKeyRef|valueFrom|from_secret|fromSecret|resolve:|ssm:|arn:aws:|keyring|Keychain|KeyVault|azure_key)
context-deny: \?[[:space:]]*["'][^"']*["'][[:space:]]+:[[:space:]]*["']
match-deny: [:=][[:space:]]*["'`]?\$
match-deny: [:=][[:space:]]*["'`]?[!~/.<>*-]
