context-deny: (vault|Vault|VAULT|secretsmanager|SecretsManager|secretKeyRef|valueFrom|from_secret|fromSecret|resolve:|ssm:|arn:aws:|keyring|Keychain|KeyVault|azure_key)
context-deny: \?[[:space:]]*["'][^"']*["'][[:space:]]+:[[:space:]]*["']
