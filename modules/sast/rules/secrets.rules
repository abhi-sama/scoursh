match-deny: [:=][[:space:]]*["'`][\^~><=]*v?[0-9]+\.[0-9xX*]+(\.[0-9xX*]+)?(\.[0-9xX*]+)?([-+][0-9A-Za-z.-]*)?["'`]$
match-deny: [:=][[:space:]]*["'`](env\(|%[A-Za-z_][A-Za-z0-9_]*%["'`]$|\{[A-Za-z_][A-Za-z0-9_.]*\}["'`]$)
match-deny: [:=][[:space:]]*["'`][A-Za-z_]+\.[A-Za-z_]+\.[A-Za-z_.]*[A-Za-z_]["'`]$
match-deny: [:=][[:space:]]*["'`]([Mm]ock|[Ff]ake|[Ss]tub|[Tt]est)[-_]
match-deny: [:=][[:space:]]*["'`](required|omitempty)(,|["'`]$)
match-deny: [:=][[:space:]]*["'`][0-9]+/[smhd](/|,|["'`]$)
# UNQUOTED-ONLY precision guards.  The first: a bare value made only of
# lowercase letters joined by . _ - or / is an identifier, a slug, a dotted
# name or a relative path, not a credential - `local secretsset=sast_hist_secrets`
# and `secret-file: relative/path` are both real matches this rule made
# against scoursh's own tree.  Deliberately NOT applied to the quoted records
# above: quoting is itself an authoring signal, and a quoted multi-word value
# under a password-shaped name is a real passphrase shape.  The accepted cost
# is stated in the header matrix: an unquoted all-lowercase hyphen/underscore
# password is not reported here.
match-deny: [:=][[:space:]]*[a-z]{1,40}[._/-][a-z._/-]{1,60}([[:space:]]|$)
# Source code assigns a CALL, an ATTRIBUTE, a CLASS, a CONSTANT or a TYPE to
# a credential-named variable far more often than a literal.  The pattern
# itself now requires the value to END at whitespace or end of line, which is
# what every `.env`, shell, Dockerfile and YAML literal does and what no call
# (`password = request.POST.get(`), keyword argument (`token=instance,`),
# subscript (`credential=form.cleaned_data["credential"]`) or TypeScript
# member (`token: string;`) does.  The guards below cover the reference shapes
# that do end a line: a dotted attribute (`secret = settings.SECRET_KEY`), a
# generic or subscript (`token: Optional[str]`), a list literal, a CamelCase
# class (`token: SocialToken | None`), an UPPER_CASE constant
# (`password=PGPASSWORD`), a pydantic `SecretStr` or TypeScript primitive
# annotation, and an enum word (`HttpTokens: optional`).  This record skips
# JS/TS source outright; the TypeScript guard is for the non-production record
# below, which reuses this pattern on JS/TS test files.  The accepted cost: an unquoted secret made only of
# letters in one of those shapes (`ABCDEFGH`, `CorrectHorse`, `abc.def1`) is
# not reported by this record.
match-deny: [:=][[:space:]]*[a-z_][a-z0-9_]*\.[A-Za-z_][A-Za-z0-9_.]*[[:space:]]?$
match-deny: [:=][[:space:]]*[A-Za-z_][A-Za-z0-9_.]*\[
match-deny: [:=][[:space:]]*\[
match-deny: [:=][[:space:]]*[A-Z][a-z]+[A-Z][A-Za-z]*[[:space:]]?$
match-deny: [:=][[:space:]]*[A-Z][A-Z_]*[[:space:]]?$
match-deny: :[[:space:]]*Secret(Str|Bytes)[[:space:]]?$
match-deny: :[[:space:]]*(string|number|boolean|bigint|symbol|object|unknown|any|never|void|undefined|Buffer|Date)[[:space:]]?$
match-deny: [:=][[:space:]]*(optional|required|enabled|disabled)[[:space:]]?$
match-deny: ([Pp][Aa][Ss][Ss]([Ww]([Oo][Rr])?[Dd]|[Pp][Hh][Rr][Aa][Ss][Ee])|[Pp][Ww][Dd])[A-Za-z0-9_-]*["']?[[:space:]]*[:=][[:space:]]*([Pp]assword|[Pp]assw0rd|[Pp]@ssw0rd|[Ss]ecret|postgres|[Aa]dmin123|[Cc]hangeit|[Ll]etmein|[Ww]elcome1?|qwerty|123456|12345678|[Pp]ass123|[Pp]assword1|[Pp]assword123|[Tt]est123|default)[[:space:]]?$
