.docker/.dockercfg:registry-auth.docker/.dockercfgsecretstrue4

# registry-auth-hub  (line 8)
#   The same credential for hub.docker.com. A second registry entry is a
#   second credential to find, not a duplicate of the first.
.docker/.dockercfg:registry-auth-hub.docker/.dockercfgsecretstrue8

