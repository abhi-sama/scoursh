auth=user	base_severity=medium	cell=bench/corpora/_slices/k8s-scenarios/root	check_id=IAC-K8S-MUTABLE_TAG-01	confidence=high	corr_file=bench/corpora/_slices/k8s-scenarios/root/docker-bench-security/deployment.yaml	cwe=CWE-494	evidence=        image: busybox:latest	exposure=unknown	fingerprint=0b626c73573d74f5291c6723dd28d802a8c801c036cfce21c5218504419f5500	first_seen=2026-09-10T11:22:14Z	last_seen=2026-09-10T11:22:14Z	loc_line=35	loc_match_digest=edb7206e07d709e3	loc_occurrence=0	loc_path=bench/corpora/_slices/k8s-scenarios/root/docker-bench-security/deployment.yaml	logical_fqn=bench/corpora/_slices/k8s-scenarios/root/docker-bench-security/deployment.yaml:35	logical_kind=file	module=iac	owasp=A08:2025	references=CWE-494	remediation=Pin the image to an immutable reference - a specific semver tag the registry\nwill not overwrite, or better, a content-addressed digest (`@sha256:...`). `:latest`\n(or no tag at all, which defaults to it) means the same manifest can deploy a different\nimage tomorrow with no corresponding change to review, and a rollback cannot pin to\n"what was actually running."	rule_digest=f400803fd5afd0e08469b888f9d7e9a9174095b5aed8bd0ec7a20a132e873d07	sensitive_data=false	severity=medium	status=new	suppressed=false	title=Container image pinned to the mutable :latest tag	_cvss_vector=CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:L/I:L/A:N	_cvss_score=5.4
auth=user	base_severity=medium	cell=bench/corpora/_slices/k8s-scenarios/root	check_id=IAC-K8S-SA_TOKEN_DEFAULT-01	confidence=medium	corr_file=bench/corpora/_slices/k8s-scenarios/root/docker-bench-security/deployment.yaml	cwe=CWE-269	evidence=kind: DaemonSet	exposure=unknown	fingerprint=0ab50324388b03bbc0bc0c326376fdcec2c8005eba08fe46fd64f8bb4228a136	first_seen=2026-09-10T11:22:14Z	last_seen=2026-09-10T11:22:14Z	loc_line=13	loc_match_digest=18f00bdf678b235b	loc_occurrence=0	loc_path=bench/corpora/_slices/k8s-scenarios/root/docker-bench-security/deployment.yaml	logical_fqn=bench/corpora/_slices/k8s-scenarios/root/docker-bench-security/deployment.yaml:13	logical_kind=file	module=iac	owasp=A01:2025	references=CWE-269	remediation=Set automountServiceAccountToken to false on the pod spec (or the\nServiceAccount) unless the workload genuinely calls the Kubernetes API. The default is\ntrue, so every pod otherwise carries a live, mountable credential for its service\naccount into a container that most workloads never use it from - exactly what a\ncontainer-escape or SSRF exploit looks for next.	rule_digest=972f26b12228894e2601b2f1ff564f37e5dd89072f92c0dc8f9df93988223820	sensitive_data=false	severity=medium	status=new	suppressed=false	title=Pod does not disable automatic service-account token mounting	_cvss_vector=CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:L/I:L/A:N	_cvss_score=5.4
