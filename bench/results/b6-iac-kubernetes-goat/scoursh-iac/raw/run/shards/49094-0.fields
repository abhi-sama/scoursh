auth=user	base_severity=critical	cell=bench/corpora/_slices/k8s-scenarios/root	check_id=IAC-K8S-PRIVILEGED-01	confidence=high	corr_file=bench/corpora/_slices/k8s-scenarios/root/docker-bench-security/deployment.yaml	cwe=CWE-269	evidence=          privileged: true	exposure=unknown	fingerprint=02ec78a6088579e6e66199aed72768b00795e39cf39c57ccd022818dd087d95d	first_seen=2026-09-10T11:22:14Z	fix_find=privileged: true	fix_kind=replace	fix_replace=privileged: false	last_seen=2026-09-10T11:22:14Z	loc_line=56	loc_match_digest=9f26cf058af1fb19	loc_occurrence=0	loc_path=bench/corpora/_slices/k8s-scenarios/root/docker-bench-security/deployment.yaml	logical_fqn=bench/corpora/_slices/k8s-scenarios/root/docker-bench-security/deployment.yaml:56	logical_kind=file	module=iac	owasp=A02:2025	references=CWE-269	remediation=Remove `privileged: true` from the container's securityContext.\nA privileged container has near-complete access to the host - device nodes, kernel\ncapabilities, and namespaces - so almost every real workload can run instead with a\nnarrow, explicit `capabilities.add` list for only the capability it actually needs.	rule_digest=4ddd873dfef3d2338036f4bb273884a0eaab9ee26821ee6124be41e68fd92744	sensitive_data=false	severity=critical	status=new	suppressed=false	title=Container runs with privileged escalation enabled	_cvss_vector=CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:L/I:L/A:N	_cvss_score=5.4
