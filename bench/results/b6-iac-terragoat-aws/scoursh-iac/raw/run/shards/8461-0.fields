auth=user	base_severity=high	cell=terraform/aws	check_id=IAC-DOCKER-ROOT_USER-01	confidence=medium	corr_file=terraform/aws/resources/Dockerfile	cwe=CWE-250	evidence=FROM python:3.7-slim	exposure=unknown	fingerprint=6d937479ae4704b00f5f9f2ced28ce2f3ed52cde39685f107dd384cf2e83b3c2	first_seen=2026-09-10T11:10:21Z	fix_find=FROM	fix_kind=insert-near	fix_snippet=RUN addgroup -S app && adduser -S app -G app\nUSER app	last_seen=2026-09-10T11:10:21Z	loc_line=1	loc_match_digest=9eae8b6800754c4b	loc_occurrence=0	loc_path=terraform/aws/resources/Dockerfile	logical_fqn=terraform/aws/resources/Dockerfile:1	logical_kind=file	module=iac	owasp=A02:2025	references=CWE-250	remediation=Create an unprivileged account (`RUN addgroup -S app && adduser -S app -G app` or\nequivalent for the base distro) and add a `USER app` instruction before the container's default\nentrypoint/cmd runs, so the process does not run as root by default. An attacker who achieves code\nexecution inside the container then does not automatically inherit root privileges in the\ncontainer's own namespace.	rule_digest=b3c54975a6da7361141eb29cf13f096d03c05f01bf02e28c960ba8b8ab65194b	sensitive_data=false	severity=high	status=new	suppressed=false	title=Dockerfile builds an image with no non-root USER instruction	_cvss_vector=CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:L/I:L/A:N	_cvss_score=5.4
auth=user	base_severity=low	cell=terraform/aws	check_id=IAC-DOCKER-UNPINNED_DIGEST-01	confidence=medium	corr_file=terraform/aws/resources/Dockerfile	cwe=CWE-829	evidence=FROM python:3.7-slim	exposure=unknown	fingerprint=925e6eaf0b45704861ef17e0b705fc2ef260c2509691bccfa4d90d3d813566f5	first_seen=2026-09-10T11:10:21Z	last_seen=2026-09-10T11:10:21Z	loc_line=1	loc_match_digest=9eae8b6800754c4b	loc_occurrence=0	loc_path=terraform/aws/resources/Dockerfile	logical_fqn=terraform/aws/resources/Dockerfile:1	logical_kind=file	module=iac	owasp=A08:2025	references=CWE-829	remediation=Pin the base image with an `@sha256:<digest>` suffix (`docker pull` and then\n`docker inspect --format '{{index .RepoDigests 0}}'` the image you intend to use, or read the\ndigest off the registry) in addition to, or instead of, a tag - a tag can be repointed at a\ndifferent image server-side, but a digest cannot.	rule_digest=a8a8262d692fd1591352e7229d94b898bb533b1429df51bb0264f9bb1b4cbb30	sensitive_data=false	severity=low	status=new	suppressed=false	title=Base image not pinned to a content digest	_cvss_vector=CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:L/I:L/A:N	_cvss_score=5.4
