{
  "openapi": "3.1.0",
  "info": {"title": "IMPORT-03 $ref/polymorphism fixture", "version": "1.0"},
  "paths": {
    "/cyclic": {
      "post": {
        "summary": "a $ref chain that loops back on itself - dropped, counted, never followed forever",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/Self"}
            }
          }
        }
      }
    },
    "/poly": {
      "post": {
        "summary": "a 3.1 oneOf - the first subschema is used, and the pick is counted",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {"type": "object", "properties": {"a": {"type": "string", "example": "x"}}},
                  {"type": "object", "properties": {"b": {"type": "string", "example": "y"}}}
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Self": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "example": "n1"},
          "child": {"$ref": "#/components/schemas/Self"}
        }
      }
    }
  }
}
